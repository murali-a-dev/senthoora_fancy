# ──────────────────────────────────────────────
# Sri Senthoora Fancy Store — Environment Config
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ──────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# Admin PIN — change this before going live
ADMIN_PIN=your_secure_pin_here

# JWT / Session secret — use a long random string
SESSION_SECRET=change_this_to_a_long_random_secret_string

# Frontend origin (for CORS in production)
# Comma-separated if multiple: https://mysite.vercel.app,https://www.mysite.com
FRONTEND_URL=http://localhost:5173

# Vite: Backend API base URL (leave empty if same-origin / Vite proxy)
# Set this on Vercel to point to your Render backend:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# ── Cloudinary ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=senthoora_fancy_showcase

# ── Firebase Admin SDK ──────────────────────
# Use these instead of credentials.json for production
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

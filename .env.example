# ==============================================================================
# Sri Senthoora Fancy Store - Environment Configuration Template
# ==============================================================================

# Server Port
PORT=3001

# Admin Security PIN (Set your custom 4-8 digit secret PIN for production)
ADMIN_PIN=1234

# Firebase Configuration
# Supports either local credentials.json (in .gitignore) or individual environment variables:
FIREBASE_PROJECT_ID=senthoora-fancy
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@senthoora-fancy.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Cloudinary Media Storage (For product image uploads)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME_HERE
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY_HERE
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET_HERE
CLOUDINARY_FOLDER=senthoora_fancy_showcase

# Frontend URL (For CORS allow-list in production, e.g. https://your-store.vercel.app)
FRONTEND_URL=http://localhost:5173
